# Cloudflare Pages _headers
# Disable caching for all pages (HTML served with or without .html extension)
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/login.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# API routes: no cache
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

# Static assets: long cache with ?v= version busting
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.json
  Cache-Control: public, max-age=3600
